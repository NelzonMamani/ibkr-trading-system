{
  "entries": [
    {
      "backup_included": true,
      "category": "REGENERABLE",
      "name": "runtime_db",
      "patterns": [
        "*.db",
        "*.sqlite",
        "*-wal",
        "*-shm",
        "*-journal"
      ],
      "purge_levels": [
        "HARD"
      ],
      "root": "/workspace/ibkr-trading-system/data"
    },
    {
      "backup_included": false,
      "category": "REGENERABLE",
      "name": "runtime_logs",
      "patterns": [
        "**/*"
      ],
      "purge_levels": [
        "LIGHT",
        "STANDARD",
        "HARD"
      ],
      "root": "/workspace/ibkr-trading-system/logs"
    },
    {
      "backup_included": false,
      "category": "REGENERABLE",
      "name": "runtime_output",
      "patterns": [
        "**/*"
      ],
      "purge_levels": [
        "LIGHT",
        "STANDARD",
        "HARD"
      ],
      "root": "/workspace/ibkr-trading-system/output"
    },
    {
      "backup_included": true,
      "category": "SEMI_PERSISTENT",
      "name": "runtime_caches",
      "patterns": [
        "**/runtime_cache*",
        "**/*cache*.json"
      ],
      "purge_levels": [
        "STANDARD",
        "HARD"
      ],
      "root": "/workspace/ibkr-trading-system/data"
    }
  ],
  "repo_root": "/workspace/ibkr-trading-system"
}