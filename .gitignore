# =========================
# IDE / ENVIRONMENT
# =========================
.idea/
.vscode/
.venv/
.env*

# =========================
# PYTHON
# =========================
__pycache__/
*.py[cod]
.pytest_cache/

# =========================
# RUNTIME / GENERATED DATA (CRITICAL)
# =========================
output/
logs/
*.log

# =========================
# DATABASES (NON-DETERMINISTIC)
# =========================
*.db
*.sqlite

# =========================
# AUDIT / EVIDENCE (GENERATED — DO NOT VERSION)
# =========================
AUDIT_EVIDENCE/
TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/

# =========================
# DATA LAYER (CACHE / NON-DETERMINISTIC)
# =========================
data/

# =========================
# LARGE / STREAM DATA
# =========================
*.jsonl

# =========================
# CONTROLLED DATA POLICY
# Allow small datasets, block generated ones
# =========================
data/**/*.csv
data/**/*.parquet

# =========================
# TEMP / BACKUP FILES
# =========================
*.tmp
*.bak

# =========================
# OS JUNK
# =========================
.DS_Store
Thumbs.db