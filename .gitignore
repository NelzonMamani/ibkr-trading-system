# =========================
# IDE / ENVIRONMENT
# =========================
.idea/
.vscode/
.venv/
.env*

# =========================
# PYTHON
# =========================
__pycache__/
*.py[cod]
.pytest_cache/

# =========================
# RUNTIME / GENERATED DATA
# =========================
output/
logs/
*.log

# =========================
# DATABASES (NON-DETERMINISTIC)
# =========================
*.db
*.sqlite

# =========================
# ROOT AUDIT EVIDENCE (RAW / NON-GOVERNED → IGNORE)
# =========================
AUDIT_EVIDENCE/

# =========================
# CATALOGUE AUDIT EVIDENCE (GOVERNED → CONTROLLED)
# =========================

# Allow catalogue path
!TRADING_OS_MASTER_CATALOGUE/
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/

# Ignore everything inside by default
TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**

# Re-allow directories (required for Git traversal)
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/

# Allow ONLY certification artifacts
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/SUMMARY.md
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/summary.md
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/final_*.md
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/FINAL_*.md

!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/platform_state.json
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/platform_integrity_state.json
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/pipeline_summary.json
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/verification*.json
!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/reconciliation*.json

!TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/**/SYSTEM_STATE_CERTIFIED.md

# =========================
# DATA LAYER (CACHE / NON-DETERMINISTIC)
# =========================
data/

# =========================
# LARGE / STREAM DATA
# =========================
*.jsonl

# =========================
# CONTROLLED DATA POLICY
# =========================
data/**/*.csv
data/**/*.parquet

# =========================
# TEMP / BACKUP FILES
# =========================
*.tmp
*.bak

# =========================
# OS JUNK
# =========================
.DS_Store
Thumbs.db