# =========================

# IDE / ENVIRONMENT

# =========================

.idea/
.venv/
.env

# =========================

# PYTHON

# =========================

**pycache**/
*.pyc

# =========================

# RUNTIME / GENERATED DATA (CRITICAL)

# =========================

output/
logs/
*.log

# =========================

# DATABASES (NON-DETERMINISTIC)

# =========================

*.db
*.sqlite

# =========================

# AUDIT / EVIDENCE (GENERATED — DO NOT VERSION)

# =========================

AUDIT_EVIDENCE/

# Also ignore audit inside catalogue (you have both)

TRADING_OS_MASTER_CATALOGUE/AUDIT_EVIDENCE/

# =========================

# DATA LAYER (CACHE / NON-DETERMINISTIC)

# =========================

data/

# (covers backups, tmp, cache, db, etc.)

# =========================

# LARGE / STREAM DATA

# =========================

*.jsonl

# =========================

# REFERENCE CACHES (NON-SOURCE-OF-TRUTH)

# =========================

# (redundant now that data/ is ignored, but kept for clarity)

data/reference/*.json
data/fundamentals/*.json

# =========================

# SAFETY (TRADING SYSTEM)

# =========================

# Prevent accidental large files

*.csv
*.parquet

# =========================

# OS JUNK

# =========================

.DS_Store
Thumbs.db
