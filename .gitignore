# =========================
# IDE / ENVIRONMENT
# =========================
.idea/
.venv/
.env

# =========================
# PYTHON
# =========================
__pycache__/
*.pyc

# =========================
# RUNTIME / GENERATED DATA (CRITICAL)
# =========================
output/
logs/

# Databases
*.db
*.sqlite

# Large structured data
*.jsonl

# Logs anywhere
*.log

# =========================
# DATA LAYER (CACHE / NON-DETERMINISTIC)
# =========================
data/backups/
data/tmp/
data/cache/

# Reference & fundamentals caches (NON-SOURCE-OF-TRUTH)
data/reference/*.json
data/fundamentals/*.json

# =========================
# SAFETY (TRADING SYSTEM)
# =========================
# Prevent accidental large files
*.csv
*.parquet

# =========================
# OS JUNK
# =========================
.DS_Store
Thumbs.db